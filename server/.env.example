# Server Environment Configuration

PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Authentication (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# AI Model Provider (Google Gemini via OpenAI SDK compatibility)
GEMINI_API_KEY=AIzaSy...
# Optional local mock provider URL for offline/zero-cost load testing (default: Gemini direct)
# MOCK_AI_URL=http://localhost:4000/v1beta/openai/

# Image Generation (ClipDrop)
CLIPDROP_API_KEY=...
# Optional mock ClipDrop URL for testing
# MOCK_CLIPDROP_URL=http://localhost:4000/text-to-image/v1

# Cloudinary CDN & Transformation
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...
