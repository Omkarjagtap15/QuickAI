# ── Mock Provider Server Configuration ──

# Port the mock server listens on
PORT=4000

# ── Gemini (Chat Completions) ──
# Simulated latency in milliseconds for chat completion requests
MOCK_LATENCY_MS=500
# Probability of returning a 500 error (0.0 = never, 1.0 = always)
MOCK_FAILURE_RATE=0

# ── ClipDrop (Text-to-Image) ──
# Simulated latency in milliseconds for image generation requests
MOCK_IMAGE_LATENCY_MS=2000
# Probability of returning a 500 error for image requests
MOCK_IMAGE_FAILURE_RATE=0

# ── Cloudinary (Image Upload) ──
# Simulated latency in milliseconds for image upload requests
MOCK_UPLOAD_LATENCY_MS=300
# Probability of returning a 500 error for upload requests
MOCK_UPLOAD_FAILURE_RATE=0
